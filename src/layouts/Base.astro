---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';

export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  ogImage?: string;
  /** Fondo oscuro detrás del header (heros con imagen a sangre). */
  headerOverImage?: boolean;
  /** Barra fija inferior en móvil. */
  mobileCta?: { href: string; label: string } | false;
  /** La página incluye la sección #lista (formulario de apertura). */
  hasLista?: boolean;
  /** Emitir canonical y og:url (false en la 404). */
  canonical?: boolean;
}

const {
  title,
  description,
  noindex = false,
  jsonLd,
  ogImage = '/images/og-image.jpg',
  headerOverImage = false,
  mobileCta = { href: '/cabanas/', label: 'Conocer las cabañas' },
  hasLista = true,
  canonical: emitCanonical = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Las redes sociales exigen URL absoluta para la imagen de preview.
const ogImageUrl = new URL(ogImage, Astro.site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {emitCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Amantia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {emitCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Amantia · Menos ruido. Más presencia." />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <slot name="head" />
  </head>
  <body class="bg-paper text-navy font-sans font-light antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-paper focus:px-4 focus:py-3">
      Saltar al contenido
    </a>
    <Header overImage={headerOverImage} listaHref={hasLista ? '#lista' : '/#lista'} />
    <main id="contenido">
      <slot />
    </main>
    <Footer hasMobileCta={!!mobileCta} />
    {mobileCta && <MobileCTA href={mobileCta.href} label={mobileCta.label} />}
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  :focus-visible {
    outline: 2px solid #7a5c24;
    outline-offset: 3px;
  }
  /* En fondos oscuros, foco en dorado suave (contraste ≥3:1) */
  .bg-navy :focus-visible,
  .text-bone :focus-visible {
    outline-color: #d4b872;
  }
  input:focus-visible {
    outline: none;
    border-bottom-width: 2px;
  }
  /* Utilidades de la marca */
  .eyebrow {
    font-size: 12px;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #7a5c24;
  }
  .shell {
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  @media (min-width: 768px) {
    .shell {
      padding-inline: 48px;
    }
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    background: #b8944b;
    color: #1a2a44;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: background-color 300ms;
  }
  .btn-primary:hover {
    background: #d4b872;
  }
  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    border: 1px solid currentColor;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .link-quiet {
    display: inline-block;
    padding: 12px 0;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .link-quiet:hover {
    color: #7a5c24;
  }
</style>
