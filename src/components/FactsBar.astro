---
// Barra de datos confirmados que se superpone al hero (ocupa el lugar del buscador de fechas
// hasta que exista motor de reservas). Solo datos de docs/strategy/datos-amantia.md.
import { SITE } from '../data/site';
const f = SITE.facts;
const items = [
  { value: `${f.cabins}`, label: 'cabañas privadas' },
  { value: `${f.guestsPerCabin}`, label: 'personas por cabaña' },
  { value: `Desde ${f.minSizeM2} m²`, label: 'con terraza' },
  { value: 'Privados', label: 'jacuzzi y piscina' },
  { value: `${f.kmFromBogota} km`, label: 'de Bogotá' },
];
---

<div class="shell relative z-10 -mt-12 md:-mt-14">
  <div class="bg-cream shadow-[0_12px_48px_rgba(26,42,68,0.08)] px-6 py-7 md:px-10 md:py-8 grid grid-cols-2 md:grid-cols-5 gap-y-6 gap-x-6 items-end">
    {items.map((it) => (
      <div class="min-w-0">
        <p class="font-serif text-2xl md:text-3xl">{it.value}</p>
        <p class="mt-1 text-[12px] tracking-[0.12em] uppercase text-ink-muted">{it.label}</p>
      </div>
    ))}
  </div>
</div>
