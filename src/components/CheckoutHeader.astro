---
// Cabecera mínima del flujo de reserva: sin menú del sitio, para no sacar a la persona del embudo.
import { SITE, waLink } from '../data/site';
---

<header class="bg-paper border-b border-linen">
  <div class="shell max-w-3xl flex h-16 items-center justify-between gap-6">
    <a href="/" class="font-serif text-base tracking-widest-3" aria-label="Amantia, volver al sitio">AMANTIA</a>
    {SITE.whatsapp && (
      <a
        href={waLink('Hola, tengo una duda sobre mi reserva en Amantia.')}
        class="text-[13px] tracking-[0.12em] uppercase underline underline-offset-4 py-3"
        target="_blank"
        rel="noopener"
        data-event="click_whatsapp"
        data-source="reservas_header"
      >¿Dudas? WhatsApp</a>
    )}
  </div>
</header>
