---
import RenderImage from './RenderImage.astro';
import { CABANAS } from '../data/cabanas';
---

<ul class="grid gap-6 md:grid-cols-3">
  {CABANAS.map((c) => (
    <li class="bg-paper min-w-0 flex flex-col">
      <RenderImage image={c.image} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/3]" />
      <div class="p-6 md:p-7 flex flex-col flex-1">
        <div class="mb-5"><h3 class="font-serif font-normal text-[26px] leading-tight">{c.name}</h3>
        <p class="mt-3 text-[15px] leading-[1.7] text-ink-muted">{c.tagline}</p></div>
        <p class="mt-auto pt-5 border-t border-linen text-[13px] tracking-[0.1em] uppercase">
          {c.size} · 2 personas · jacuzzi y piscina privados
        </p>
      </div>
    </li>
  ))}
</ul>
