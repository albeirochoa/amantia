---
export interface Props {
  eyebrow?: string;
  title: string;
  /** Nivel del título (h2 por defecto). */
  as?: 'h2' | 'h3';
}
const { eyebrow, title, as: Tag = 'h2' } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-16 mb-10 md:mb-14">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag class="mt-4 font-serif font-normal text-[34px] md:text-5xl leading-[1.15] tracking-[-0.01em]">{title}</Tag>
  </div>
  {Astro.slots.has('default') && (
    <div class="max-w-sm text-[16px] leading-[1.8] text-ink-muted"><slot /></div>
  )}
</div>
