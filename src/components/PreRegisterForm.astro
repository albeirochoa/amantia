---
// Componente del formulario de pre-registro
// MailerLite embed form - reemplaza ACCOUNT_ID y FORM_ID
const ACCOUNT_ID = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT_ID || 'YOUR_ACCOUNT_ID';
const FORM_ID = import.meta.env.PUBLIC_MAILERLITE_FORM_ID || 'YOUR_FORM_ID';
---

<form
  id="preregister-form"
  class="space-y-5"
  data-account-id={ACCOUNT_ID}
  data-form-id={FORM_ID}
>
  <div>
    <label for="name" class="block text-xs uppercase tracking-widest-2 text-gold-soft mb-2">
      Nombre completo
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      class="w-full bg-transparent border-b border-bone/30 focus:border-gold py-2 text-bone placeholder-bone/40 focus:outline-none transition-colors"
    />
  </div>

  <div>
    <label for="email" class="block text-xs uppercase tracking-widest-2 text-gold-soft mb-2">
      Correo electrónico
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="w-full bg-transparent border-b border-bone/30 focus:border-gold py-2 text-bone placeholder-bone/40 focus:outline-none transition-colors"
    />
  </div>

  <div class="pt-4">
    <button
      type="submit"
      class="w-full bg-gold hover:bg-gold-soft text-navy font-medium uppercase tracking-widest-2 text-sm py-4 transition-colors duration-300"
    >
      <span class="btn-text">Pre-registrarse</span>
      <span class="btn-loading hidden">Enviando...</span>
    </button>
  </div>

  <p class="text-xs text-bone/50 leading-relaxed pt-2">
    El pre-registro no garantiza la invitación. Orígenes cerrará cuando las cinco parejas hayan sido seleccionadas.
  </p>
</form>

<div id="success-message" class="hidden text-center space-y-4 py-8">
  <div class="text-gold text-4xl font-serif italic">Gracias.</div>
  <p class="text-bone/80 leading-relaxed">
    Recibimos su pre-registro.<br />
    El equipo Amantia revisará cada solicitud con calma.<br />
    Si su pareja es seleccionada para Orígenes, los contactaremos directamente.
  </p>
  <p class="text-bone/60 text-sm pt-4">
    Mientras tanto, pueden seguir el proceso en
    <a href="https://instagram.com/amantiacundinamarca" class="text-gold hover:text-gold-soft underline">
      @amantiacundinamarca
    </a>
  </p>
</div>

<div id="error-message" class="hidden text-center text-red-300/80 text-sm py-4">
  Hubo un problema al enviar el formulario. Por favor inténtelo de nuevo o escríbanos a hola@amantia.com.co
</div>

<script>
  const form = document.getElementById('preregister-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-message');
  const errorMsg = document.getElementById('error-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const btnText = button.querySelector('.btn-text');
      const btnLoading = button.querySelector('.btn-loading');

      // Estado de carga
      button.disabled = true;
      btnText?.classList.add('hidden');
      btnLoading?.classList.remove('hidden');
      errorMsg?.classList.add('hidden');

      const accountId = form.dataset.accountId;
      const formId = form.dataset.formId;

      const formData = new FormData(form);
      const data = {
        fields: {
          name: formData.get('name'),
          email: formData.get('email'),
        },
        ml_subscribe: '1',
      };

      try {
        // MailerLite endpoint público para forms embebidos
        const response = await fetch(
          `https://assets.mailerlite.com/jsonp/${accountId}/forms/${formId}/subscribe`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
              'fields[name]': String(formData.get('name') || ''),
              'fields[email]': String(formData.get('email') || ''),
              'ml-submit': '1',
              'anticsrf': 'true',
            }),
          }
        );

        if (response.ok) {
          form.classList.add('hidden');
          successMsg?.classList.remove('hidden');
        } else {
          throw new Error('Submission failed');
        }
      } catch (err) {
        errorMsg?.classList.remove('hidden');
        button.disabled = false;
        btnText?.classList.remove('hidden');
        btnLoading?.classList.add('hidden');
      }
    });
  }
</script>
