---
import { srcset, src, label, type Render } from '../data/renders';

export interface Props {
  image: Render;
  sizes?: string;
  class?: string;
  /** Imagen principal (LCP): carga inmediata. */
  priority?: boolean;
  /** Muestra la etiqueta "Render" sobre la imagen. */
  badge?: boolean;
}
const { image, sizes = '100vw', class: cls = '', priority = false, badge = true } = Astro.props;
---

<div class:list={['relative overflow-hidden bg-linen', cls]}>
  <img
    src={src(image.file)}
    srcset={srcset(image.file)}
    sizes={sizes}
    alt={image.alt}
    width="1600"
    height={image.h}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="h-full w-full object-cover"
  />
  {badge && (
    <span class="absolute bottom-3 right-3 bg-paper/90 px-2.5 py-1 text-[11px] tracking-[0.12em] uppercase text-navy">
      {label(image)}
    </span>
  )}
</div>
