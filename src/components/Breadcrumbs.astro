---
export interface Props {
  current: string;
}
const { current } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: current, item: url },
  ],
};
---

<nav aria-label="Ruta" class="shell pt-10 text-[12px] tracking-[0.2em] uppercase text-ink-muted">
  <a href="/" class="hover:text-navy">Inicio</a> <span aria-hidden="true" class="mx-2">/</span> <span aria-current="page">{current}</span>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
