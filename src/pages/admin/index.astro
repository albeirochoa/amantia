---
// /admin/ · Panel de reservas. noindex, fuera del sitemap, sin enlaces desde el sitio.
// Ingreso con enlace al correo autorizado (ADMIN_EMAILS). Vistas: Inicio, Calendario, Reservas y Analítica. Ver ADR-004.
// Interfaz de herramienta: conserva logo y paleta de Amantia, pero con tipografía sans, estados con color semántico
// y tema claro/oscuro opcional.
import Base from '../../layouts/Base.astro';

const NAV = [
  { id: 'inicio', label: 'Inicio', icon: 'M4 11l8-7 8 7v9H4z' },
  { id: 'calendario', label: 'Calendario', icon: 'M4 6h16v14H4zM4 10h16M9 3v4M15 3v4' },
  { id: 'reservas', label: 'Reservas', icon: 'M5 6h14M5 12h14M5 18h14' },
  { id: 'analitica', label: 'Analítica', icon: 'M5 20V10M12 20V4M19 20v-7' },
];
---

<Base title="Panel · Amantia" description="Panel de reservas de Amantia." noindex chrome="none" analytics={false} mobileCta={false} hasLista={false}>
  <!-- PWA solo del panel (alcance /admin/); el resto del sitio no es una app. -->
  <link slot="head" rel="manifest" href="/admin/manifest.webmanifest" />
  <meta slot="head" name="theme-color" content="#1A2A44" />
  <!-- Tema antes de pintar: el elegido en este navegador o, si no hay, el del sistema. -->
  <script slot="head" is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('amt_admin_theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    })();
  </script>

  <!-- Barra propia del panel: marca, tema y sesión. Sin menú ni pie del sitio público. -->
  <header class="app-ui bg-paper border-b border-linen pt-[env(safe-area-inset-top)]">
    <div class="shell max-w-6xl flex h-14 items-center justify-between gap-4">
      <p class="font-serif text-base tracking-widest-3">AMANTIA <span class="font-sans text-[12px] font-medium tracking-normal text-ink-muted ml-2">Panel</span></p>
      <div class="flex items-center gap-1 text-[13px] text-ink-muted">
        <span id="sesion" hidden class="flex items-center gap-3 mr-1">
          <span id="admin-email" class="hidden sm:inline"></span>
          <button type="button" class="link-tool py-3" id="btn-salir">Salir</button>
        </span>
        <button type="button" id="btn-tema" class="h-11 w-11 flex items-center justify-center rounded-md hover:bg-sand" aria-pressed="false" aria-label="Cambiar tema">
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4" /></svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
        </button>
      </div>
    </div>
  </header>

  <div class="app-ui shell max-w-6xl" id="admin">
    <section data-vista="cargando" class="pt-8"><p class="text-[15px] text-ink-muted">Cargando…</p></section>

    <!-- Ingreso -->
    <section data-vista="login" hidden class="max-w-md py-10">
      <h1 class="text-[22px] font-medium leading-tight tracking-[-0.01em]">Entrar al panel</h1>
      <p class="mt-2 text-[15px] leading-[1.6] text-ink-muted">Escribe tu correo y te enviamos un enlace para entrar.</p>
      <form id="form-login" class="mt-6" novalidate>
        <label class="block">
          <span class="etiqueta">Correo</span>
          <input name="email" type="email" autocomplete="email" required class="campo" />
        </label>
        <button class="btn-primary w-full mt-5" type="submit">Enviarme el enlace</button>
      </form>
      <p class="mt-4 text-[15px] min-h-[1.5em]" id="msg-login" role="status"></p>
    </section>

    <!-- Aplicación: navegación inferior en el celular, lateral en computador -->
    <div data-vista="app" hidden class="pt-6 pb-28 lg:pb-16 lg:grid lg:grid-cols-[190px_minmax(0,1fr)] lg:gap-10">
      <nav
        aria-label="Secciones"
        class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 bg-paper border-t border-linen pb-[env(safe-area-inset-bottom)] lg:static lg:block lg:self-start lg:sticky lg:top-6 lg:border-0 lg:bg-transparent lg:pb-0"
      >
        {NAV.map((n) => (
          <button
            type="button"
            data-nav={n.id}
            aria-current="false"
            class="nav-item flex w-full flex-col lg:flex-row items-center gap-1 lg:gap-3 py-2.5 lg:py-2.5 lg:px-3 text-[12px] lg:text-[14px] font-medium text-ink-muted border-t-2 border-transparent lg:border-t-0 lg:rounded-md"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d={n.icon} /></svg>
            <span>{n.label}</span>
          </button>
        ))}
      </nav>

      <div class="min-w-0">
        {NAV.map((n, i) => <div data-view={n.id} hidden={i !== 0}></div>)}
      </div>
    </div>
  </div>
</Base>

<script>
  import { initAdmin } from '../../scripts/admin/main';
  initAdmin();
</script>

<style is:global>
  [hidden] {
    display: none !important;
  }

  /* ── Colores semánticos (claro) ─────────────────────────────── */
  :root {
    --ok-bg: #e1eee5; --ok-fg: #1f5130; --ok-bar: #2f6b45; --ok-bar-fg: #ffffff;
    --warn-bg: #fbefc9; --warn-fg: #7a5a10; --warn-bar: #e8c46a; --warn-bar-fg: #3b2f0c;
    --bad-bg: #f7dcdc; --bad-fg: #9b2c2c;
    --off-bg: #e6e0d4; --off-fg: #4f5b70;
    --line-strong: #1a2a44;
    --tool-ink: #1a2a44; --tool-bg: #faf8f3;
  }
  /* ── Tema oscuro ────────────────────────────────────────────── */
  html[data-theme='dark'] {
    color-scheme: dark;
    --ok-bg: #1f3a2a; --ok-fg: #9fd6b2; --ok-bar: #3f8a5b; --ok-bar-fg: #ffffff;
    --warn-bg: #43361a; --warn-fg: #f0cf7a; --warn-bar: #c99a2e; --warn-bar-fg: #1d1606;
    --bad-bg: #4a2323; --bad-fg: #f2a7a7;
    --off-bg: #2c3a54; --off-fg: #a3aec2;
    --line-strong: #6f7d96;
    --tool-ink: #e8e4da; --tool-bg: #18233a;
  }
  html[data-theme='dark'] body.bg-paper { background: #0f1626; }
  html[data-theme='dark'] .bg-paper { background-color: #18233a; }
  html[data-theme='dark'] .bg-sand { background-color: #1f2c47; }
  html[data-theme='dark'] .bg-linen { background-color: #2a3855; }
  html[data-theme='dark'] .bg-sand\/60 { background-color: rgba(31, 44, 71, 0.6); }
  html[data-theme='dark'] .text-navy { color: #e8e4da; }
  html[data-theme='dark'] .text-ink-muted { color: #a3aec2; }
  html[data-theme='dark'] .text-gold-dark { color: #d4b872; }
  html[data-theme='dark'] .bg-gold-dark { background-color: #d4b872; }
  html[data-theme='dark'] .border-linen,
  html[data-theme='dark'] .border-linen\/70 { border-color: #2c3a54; }
  html[data-theme='dark'] .divide-linen > :not([hidden]) ~ :not([hidden]) { border-color: #2c3a54; }
  html[data-theme='dark'] .hover\:bg-sand:hover,
  html[data-theme='dark'] .hover\:bg-linen\/60:hover { background-color: #26344f; }
  html[data-theme='dark'] .bg-navy\/40 { background-color: rgba(0, 0, 0, 0.6); }
  html[data-theme='dark'] .hover\:border-gold-dark:hover { border-color: #d4b872; }
  html[data-theme='dark'] .bloqueo { background: repeating-linear-gradient(135deg, #2a3855, #2a3855 4px, #1f2c47 4px, #1f2c47 8px); }
  html[data-theme='dark'] .campo option { background: #18233a; color: #e8e4da; }

  /* Tema: se muestra el icono de la acción contraria al tema actual */
  .icon-sun { display: none; }
  html[data-theme='dark'] .icon-sun { display: block; }
  html[data-theme='dark'] .icon-moon { display: none; }

  /* ── Tipografía de herramienta ──────────────────────────────── */
  .app-ui { font-weight: 400; }
  .etiqueta { font-size: 13px; font-weight: 500; color: #4f5b70; }
  html[data-theme='dark'] .etiqueta { color: #a3aec2; }
  .tabular-nums { font-variant-numeric: tabular-nums; }
  .link-tool { text-decoration: underline; text-underline-offset: 4px; }
  .link-tool:hover { color: #7a5c24; }
  html[data-theme='dark'] .link-tool:hover { color: #d4b872; }

  /* Botones de herramienta: sin mayúsculas ni letras separadas, esquinas suaves */
  .app-ui .btn-primary,
  .app-ui .btn-outline {
    letter-spacing: 0;
    text-transform: none;
    font-weight: 500;
    font-size: 14px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 6px;
  }
  .accion {
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid currentColor;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }
  .accion.peligro { color: var(--bad-fg); }
  .accion-on { background: var(--tool-ink); color: var(--tool-bg); border-color: var(--tool-ink); }

  .campo {
    display: block;
    width: 100%;
    margin-top: 4px;
    padding: 9px 0;
    background: transparent;
    border-bottom: 1px solid var(--line-strong);
    font-size: 16px;
    border-radius: 0;
  }

  /* ── Estados ────────────────────────────────────────────────── */
  .chip { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; white-space: nowrap; }
  .chip-ok { background: var(--ok-bg); color: var(--ok-fg); }
  .chip-warn { background: var(--warn-bg); color: var(--warn-fg); }
  .chip-bad { background: var(--bad-bg); color: var(--bad-fg); }
  .chip-off { background: var(--off-bg); color: var(--off-fg); }
  .bar-ok { background: var(--ok-bar); color: var(--ok-bar-fg); }
  .bar-warn { background: var(--warn-bar); color: var(--warn-bar-fg); }
  .note-bad { background: var(--bad-bg); color: var(--bad-fg); }
  .note-warn { background: var(--warn-bg); color: var(--warn-fg); }
  .text-bad { color: var(--bad-fg); }
  .text-good { color: var(--ok-fg); }
  .toast { background: var(--tool-ink); color: var(--tool-bg); }
  .toast-bad { background: #9b2c2c; color: #fff; }

  /* Noches bloqueadas en el calendario */
  .bloqueo { background: repeating-linear-gradient(135deg, #e6e0d4, #e6e0d4 4px, #f1ede4 4px, #f1ede4 8px); }

  /* Navegación */
  .nav-item[aria-current='page'] { color: #1a2a44; border-top-color: #b8944b; }
  html[data-theme='dark'] .nav-item[aria-current='page'] { color: #e8e4da; border-top-color: #d4b872; }
  @media (min-width: 1024px) {
    .nav-item[aria-current='page'] { background: #f1ede4; }
    html[data-theme='dark'] .nav-item[aria-current='page'] { background: #1f2c47; }
  }
</style>
