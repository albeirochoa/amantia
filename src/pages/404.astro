---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada · Amantia"
  description="Esta página no existe. Vuelva al inicio de Amantia, tres cabañas privadas para parejas en Quebradanegra, Cundinamarca."
  noindex
  mobileCta={false}
  hasLista={false}
  canonical={false}
>
  <section class="shell py-28 md:py-40 text-center">
    <p class="eyebrow">Página no encontrada</p>
    <h1 class="mt-6 font-serif font-normal text-[34px] md:text-5xl leading-[1.2]">Este camino no lleva a ningún lado.</h1>
    <p class="mt-6 font-serif italic text-[20px] text-gold-dark">A veces perderse también es parte de llegar.</p>
    <a href="/" class="btn-primary mt-12">Volver al inicio</a>
  </section>
</Base>
