---
// Home: marca y experiencia (ADR-003). Sin "glamping" en el copy visible.
// Title, H1 y frase-entidad según docs/seo/url-map.md y ADR-003.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FactsBar from '../components/FactsBar.astro';
import Split from '../components/Split.astro';
import SectionIntro from '../components/SectionIntro.astro';
import CabinCards from '../components/CabinCards.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import ListaApertura from '../components/ListaApertura.astro';
import { RENDERS } from '../data/renders';
import { SITE, QN } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${SITE.url}/#lodging`,
  name: 'Amantia',
  url: `${SITE.url}/`,
  image: `${SITE.url}/images/og-image.jpg`,
  hasMap: `https://www.google.com/maps?q=${SITE.geo.lat},${SITE.geo.lon}`,
  description: SITE.entity,
  email: SITE.email,
  telephone: SITE.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lon, elevation: SITE.geo.elevation },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'Quebradanegra',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Cundinamarca' },
  },
  numberOfRooms: SITE.facts.cabins,
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Jacuzzi calefactado privado', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Piscina privada al aire libre', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Cinema privado', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Sistema de recuperación corporal', value: true },
  ],
  // Sin nombres ni m² hasta que sean definitivos (nombres provisionales; área por aclarar).
  containsPlace: Array.from({ length: SITE.facts.cabins }, () => ({
    '@type': 'Accommodation',
    occupancy: { '@type': 'QuantitativeValue', maxValue: SITE.facts.guestsPerCabin },
  })),
  // TODO: sameAs (Instagram, Google Business Profile), priceRange cuando existan.
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Amantia', url: `${SITE.url}/` };

// Cada pregunta vive en una sola página (ADR-003, enmienda 1).
const faqs = [
  { q: '¿Qué es Amantia?', a: 'Un refugio de tres cabañas privadas para parejas. Cada cabaña tiene su propia piscina al aire libre, jacuzzi calefactado, cinema privado y un sistema de recuperación corporal.' },
  { q: '¿Dónde queda Amantia?', a: 'En la vereda Casa Vieja, Quebradanegra (Cundinamarca), a 90 km de Bogotá.' },
  { q: '¿Cuándo abren?', a: 'La obra se estima terminar a finales de 2026. Quienes se inscriban en la lista de apertura recibirán primero las fechas y las tarifas.' },
];
---

<Base
  title="Amantia · Cabañas privadas de lujo para dos"
  description="Tres cabañas privadas de lujo para parejas, con jacuzzi calefactado y piscina propios. Un refugio en Quebradanegra, Cundinamarca, a 90 km de Bogotá."
  jsonLd={[jsonLd, website]}
  headerOverImage
>
  <Hero
    image={RENDERS.piscinaAtardecer}
    h1="Amantia"
    h1Style="brand"
    subtitle="Un refugio para dos."
    facts={['Tres cabañas privadas', 'Piscina y jacuzzi solo para ustedes', 'A 90 km de Bogotá']}
    cta={{ href: '/cabanas/', label: 'Conocer las cabañas' }}
    secondary={{ href: '#lista', label: 'Avísenme cuando abran' }}
  />
  <FactsBar />

  <section class="shell py-24 md:py-36 grid gap-8 md:grid-cols-12">
    <p class="eyebrow md:col-span-3 md:pt-3">{SITE.tagline}</p>
    <p class="md:col-start-5 md:col-span-8 font-serif text-[26px] md:text-[36px] leading-[1.45]">{SITE.entity}</p>
  </section>

  <Split image={RENDERS.terrazaNoche} eyebrow="La cabaña" title="Sin agenda. Sin interrupciones. Sin prisa.">
    <p>Una piscina al aire libre y un jacuzzi calefactado que no se comparten con nadie.</p>
    <p>Cinema privado desde la cama y un sistema de recuperación corporal que el cuerpo agradece.</p>
    <a href="/cabanas/" class="link-quiet text-navy">Ver las cabañas</a>
  </Split>

  <section class="bg-sand py-24 md:py-32">
    <div class="shell">
      <SectionIntro eyebrow="Las cabañas" title="Tres cabañas. Cada una, solo para dos.">
        Cada una con su propia vista. Los detalles de cada cabaña se anunciarán con la apertura.
      </SectionIntro>
      <CabinCards />
      <div class="mt-12"><a href="/cabanas/" class="link-quiet">Conocer las cabañas</a></div>
    </div>
  </section>

  <section class="shell py-24 md:py-32">
    <SectionIntro eyebrow="El proyecto" title="Japandi tropical: piedra, madera y luz cálida.">
      Muros de piedra natural, maderas en tono nogal, pisos de microcemento y fibras naturales. Todas las imágenes de esta sección son renders del diseño arquitectónico.
    </SectionIntro>
    <Gallery images={[RENDERS.habitacionVentanal, RENDERS.banoDucha, RENDERS.interiorPiedra, RENDERS.habitacionCalida, RENDERS.banoLavamanos, RENDERS.interiorBarra]} />
  </section>

  <Split image={RENDERS.piscinaDia} imageSide="right" tone="dark" eyebrow="El lugar" title="Otro clima, a 90 km de Bogotá." id="lugar">
    <p>Días de 28 °C y noches frescas de 17 °C en la vereda Casa Vieja, Quebradanegra, a pocos kilómetros de Villeta.</p>
    <p>El café tiene origen. El pan también. Quien ordeña temprano, quien abre la tienda, la familia que cultiva el café.</p>
    <a href={QN.queHacer} class="link-quiet text-bone" rel="noopener">Qué hacer en la zona (QuebradaNegra.com)</a>
  </Split>

  <section class="shell py-24 md:py-32 grid gap-14 md:grid-cols-3 md:gap-12">
    <div>
      <p class="eyebrow">Para celebrar</p>
      <p class="mt-4 font-serif text-[26px] leading-[1.4]">Un aniversario. Una pregunta importante.</p>
      <p class="mt-4 text-[16px] leading-[1.8] text-ink-muted">Dos personas, una cabaña privada y el tiempo suficiente para volver a estar.</p>
    </div>
    <div>
      <p class="eyebrow">La obra hoy</p>
      <p class="mt-4 font-serif text-[26px] leading-[1.4]">En construcción.</p>
      <p class="mt-4 text-[16px] leading-[1.8] text-ink-muted">Las tres cabañas se están terminando; la obra se estima terminar a finales de 2026. Pronto compartiremos fotos reales.</p>
    </div>
    <div>
      <p class="eyebrow">Orígenes</p>
      <p class="mt-4 font-serif text-[26px] leading-[1.4]">Antes de abrir, cinco parejas vivirán Amantia sin costo.</p>
      <a href="/origenes/" class="link-quiet mt-2">Conocer Orígenes</a>
    </div>
  </section>

  <section class="bg-cream py-24 md:py-32 text-center">
    <div class="shell">
      <p class="eyebrow">Amantia</p>
      <p class="mt-6 font-serif italic text-[30px] md:text-[44px] leading-[1.35]">{SITE.tagline}</p>
    </div>
  </section>

  <Faq items={faqs} />
  <ListaApertura />
</Base>
