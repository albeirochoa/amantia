{
  "name": "amantia-coming-soon",
  "type": "module",
  "version": "1.0.0",
  "description": "Coming soon de Amantia · Pre-registro Orígenes",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "dev:reservas": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply amantia-reservas --local",
    "db:seed:local": "wrangler d1 execute amantia-reservas --local --file=scripts/seed-dev.sql",
    "db:migrate:remote": "wrangler d1 migrations apply amantia-reservas --remote"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/tailwind": "^5.1.2",
    "tailwindcss": "^3.4.13"
  }
}
