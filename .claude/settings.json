{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npx astro check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git log:*)",
      "Bash(git init)",
      "Bash(git remote:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(dig:*)",
      "Read(src/**)",
      "Read(public/**)",
      "Read(.env.example)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(*.md)",
      "Write(src/**)",
      "Write(public/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)",
      "Bash(curl:*sendgrid*)",
      "Bash(curl:*twilio*)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "0"
  }
}
